---
// PAGE CONTACT : src/pages/contact.astro  →  adresse "/contact"
//
// ⚠ ATTENTION : Astro génère un site statique, il n'y a pas de serveur pour recevoir ce
// formulaire. Sur l'ancien site, c'est Webflow qui s'en chargeait. Il faut maintenant
// brancher un service externe, par exemple :
//   - Formspree (https://formspree.io)
//   - Web3Forms (https://web3forms.com)
// Le service fournit une adresse : collez-la dans la variable "actionFormulaire" ci-dessous.
// Tant qu'elle vaut "#", l'envoi ne fait rien.

import Layout from '../layouts/Layout.astro';
import { site } from '../data/site';

const actionFormulaire = '#';

const services = ['Digital & Data', 'Ingénierie', 'Éco-Ingénierie', 'Autre'];
const sources = ['LinkedIn', 'Instagram', 'Google', 'Évènement', 'Recommandation', 'Autre'];
---

<Layout
  titre="Contact et devis – N7 Consulting, Junior-Entreprise Toulouse"
  description="Un projet en digital, ingénierie ou éco-ingénierie ? Contactez la Junior-Entreprise de l'ENSEEIHT, 2 rue Charles Camichel à Toulouse."
>
  <section class="section">
    <div class="conteneur contact">
      <div>
        <h1>Contact</h1>
        <h2>Un besoin particulier ? Cela nous intéresse !</h2>
        <p>
          Vous voulez un devis ? Vous avez une question ou vous avez besoin d’un rendez-vous ?
          Remplissez le formulaire et nous vous répondrons dans les plus brefs délais !
        </p>

        <ul class="coordonnees">
          <li>
            <strong>Adresse</strong><br />
            <a href={site.lienCarte} target="_blank" rel="noopener">{site.adresse}</a>
          </li>
          <li>
            <strong>E-mail</strong><br />
            <a href={`mailto:${site.email}`}>{site.email}</a>
          </li>
          <li>
            <strong>Réseaux</strong><br />
            <a href={site.linkedin} target="_blank" rel="noopener">LinkedIn</a> ·
            <a href={site.instagram} target="_blank" rel="noopener">Instagram</a>
          </li>
        </ul>
      </div>

      <form action={actionFormulaire} method="POST">
        <label for="prenom">Prénom</label>
        <input id="prenom" name="prenom" type="text" autocomplete="given-name" required />

        <label for="nom">Nom</label>
        <input id="nom" name="nom" type="text" autocomplete="family-name" required />

        <label for="email">Adresse e-mail</label>
        <input id="email" name="email" type="email" autocomplete="email" required />

        <label for="telephone">Téléphone</label>
        <input id="telephone" name="telephone" type="tel" autocomplete="tel" />

        <label for="service">Services</label>
        <select id="service" name="service" required>
          <option value="" disabled selected>Choisissez un service</option>
          {services.map((s) => <option value={s}>{s}</option>)}
        </select>

        <label for="message">Informations</label>
        <textarea id="message" name="message" rows="6" required></textarea>

        <label for="source">Comment nous avez-vous connu ?</label>
        <select id="source" name="source">
          <option value="" disabled selected>Choisissez une réponse</option>
          {sources.map((s) => <option value={s}>{s}</option>)}
        </select>

        <p class="rgpd">
          Vos données sont uniquement utilisées pour traiter votre demande
          (<a href="/mentions-legales">politique de confidentialité</a>).
        </p>

        <button class="bouton" type="submit">Envoyer</button>
      </form>
    </div>
  </section>
</Layout>

<style>
  .contact {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 3rem;
    align-items: start;
  }

  .coordonnees {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
  }

  .coordonnees li {
    margin-bottom: 1rem;
  }

  form {
    display: grid;
    gap: 0.4rem;
    background: var(--bleu-pale);
    padding: 2rem;
    border-radius: var(--rayon);
  }

  label {
    font-weight: 600;
    margin-top: 0.6rem;
  }

  input,
  select,
  textarea {
    width: 100%;
    padding: 0.75rem 1rem;
    border: 1px solid var(--couleur-bordure);
    border-radius: 10px;
    font: inherit;
    background: #fff;
  }

  input:focus,
  select:focus,
  textarea:focus {
    outline: 2px solid var(--bleu);
    border-color: transparent;
  }

  .rgpd {
    font-size: 0.85rem;
    color: var(--couleur-texte-doux);
    margin: 0.8rem 0 0;
  }

  button {
    margin-top: 0.5rem;
    justify-self: start;
  }
</style>
