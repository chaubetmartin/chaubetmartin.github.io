---
// COMPOSANT : Carte d'un article d'actualité (utilisée sur l'accueil et sur /actualites).
// Elle reçoit directement un article de la collection "actualites".

import type { CollectionEntry } from 'astro:content';

interface Props {
  article: CollectionEntry<'actualites'>;
}

const { article } = Astro.props;
const { titre, resume, categorie, date, image, imageAlt } = article.data;
const lienClass = Astro.url.pathname === '/' ? 'carte__lien' : 'carte__lien bouton--jaune';

// Date en français : "20 octobre 2026".
const dateLisible = date.toLocaleDateString('fr-FR', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});
---

<article class="carte">
  {image && <img class="carte__image" src={image} alt={imageAlt ?? titre} loading="lazy" />}
  <p class="carte__meta">
    <span class="carte__categorie">{categorie}</span>
    <time datetime={date.toISOString().slice(0, 10)}>{dateLisible}</time>
  </p>
  <h3>{titre}</h3>
  <p class="carte__resume">{resume}</p>
  <a class={lienClass} href={`/actualites/${article.id}`}>Lire l'article →</a>
</article>

<style>
  .carte {
    display: flex;
    flex-direction: column;
    background: var(--couleur-fond);
    border: 1px solid var(--couleur-bordure);
    border-radius: var(--rayon);
    padding: 1.75rem;
    transition:
      transform 0.2s,
      box-shadow 0.2s;
  }

  .carte__image {
    width: calc(100% + 3.5rem);
    max-width: none;
    height: 190px;
    margin: -1.75rem -1.75rem 1.25rem;
    object-fit: cover;
    border-radius: var(--rayon) var(--rayon) 0 0;
  }

  .carte:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 28px rgba(10, 31, 68, 0.1);
  }

  .carte__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.9rem;
    align-items: center;
    font-size: 0.85rem;
    color: var(--couleur-texte-doux);
    margin-bottom: 0.75rem;
  }

  .carte__categorie {
    background: var(--bleu-pale);
    color: var(--bleu-fonce);
    font-weight: 600;
    padding: 0.15rem 0.7rem;
    border-radius: 999px;
  }

  .carte__resume {
    flex: 1;
    color: var(--couleur-texte-doux);
  }

  .carte__lien {
    display: inline-block;
    align-self: flex-start;
    font-weight: 600;
    text-decoration: none;
  }

  .carte__lien:hover {
    text-decoration: underline;
  }

  .carte__lien.bouton--jaune {
    padding: 0.65rem 0.9rem;
    text-decoration: none;
  }
</style>
