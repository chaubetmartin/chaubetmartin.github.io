---
// COMPOSANT : Bandeau d'en-tête de page (grand titre sur fond bleu nuit).
// Il se configure avec des "props" (titre, sous-titre) et un <slot /> pour les boutons :
// tout ce qu'on écrit entre <Hero> et </Hero> est inséré à la place du <slot />.

interface Props {
  titre: string;
  sousTitre?: string;
}

const { titre, sousTitre } = Astro.props;
---

<section class="hero">
  <div class="conteneur">
    <h1>{titre}</h1>
    {sousTitre && <p class="hero__sous-titre">{sousTitre}</p>}
    <div class="actions actions--centre">
      <slot />
    </div>
  </div>
</section>

<style>
  .hero {
    padding: 5.5rem 0 5rem;
    text-align: center;
    color: var(--jaune-clair);
    background: linear-gradient(160deg, var(--bleu-nuit) 0%, #12357a 100%);
  }

  .hero h1 {
    color: var(--jaune);
    max-width: 52rem;
    margin-inline: auto;
  }

  .hero__sous-titre {
    max-width: 44rem;
    margin: 0 auto 2rem;
    font-size: 1.15rem;
    color: var(--jaune-clair);
  }
</style>
