---
// PAGE 404 : src/pages/404.astro
// Astro l'affiche automatiquement quand une adresse n'existe pas.
import Layout from '../layouts/Layout.astro';
---

<Layout titre="Page introuvable – N7 Consulting">
  <section class="section">
    <div class="conteneur introuvable">
      <h1>404</h1>
      <p>Cette page n'existe pas ou a été déplacée.</p>
      <a class="bouton" href="/">Retour à l'accueil</a>
    </div>
  </section>
</Layout>

<style>
  .introuvable {
    text-align: center;
    padding: 4rem 0;
  }
</style>
